# Copy this file to apps/web/.env.local and fill in real values
# NEVER commit .env.local to git

# Supabase (get from supabase.com -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google AI (get from aistudio.google.com)
GOOGLE_AI_API_KEY=your-gemini-api-key-here

# Upstash Redis (get from upstash.com -> Redis -> REST API)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here

# Resend Email (get from resend.com -> API Keys)
RESEND_API_KEY=re_your-resend-key-here
RESEND_FROM_EMAIL=memory@yourdomain.com

# Sentry (get from sentry.io -> Project -> Settings -> Client Keys)
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# App URL (set to http://localhost:3000 for local dev, your domain in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron secret (generate a random string for securing cron endpoints)
CRON_SECRET=your-random-secret-here
